# Axiom configuration. Copy to `.env` (never commit it) and fill in. Only the backend reads this file.
# Everything is optional to *start* the app — without Upstox keys it runs on clearly-labelled demo data.

# ── Upstox (https://account.upstox.com/developer/apps) ────────────────────────────────────────
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
# Must match, character for character, the redirect URL registered in your Upstox app.
UPSTOX_REDIRECT_URI=http://localhost:8000/auth/callback
# Only if Upstox asks for an algo name on your app (sent as the X-Algo-Name header). Usually blank.
UPSTOX_ALGO_NAME=
# Optional manual token override (normally leave blank and use "Connect Upstox" in the app).
UPSTOX_ACCESS_TOKEN=

# ── Neon Postgres (optional — falls back to a local SQLite file) ──────────────────────────────
# Neon console → your project → Connect → copy the connection string. The pooled one (host contains
# "-pooler") is the best fit. Tables are created automatically on first connect (backend/migrations).
DATABASE_URL=

# ── Claude (Suggestions tab) ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# ── Trading & risk ────────────────────────────────────────────────────────────────────────────
# true  = simulated fills on real prices, no orders reach Upstox.  false = REAL ORDERS.
# The Bot tab can override this per run (live needs a typed confirmation). Unparseable values abort startup.
PAPER_TRADE=true
# Today's realised + unrealised loss (₹) at which the bot halts and flattens.
MAX_DAILY_LOSS=5000
MAX_OPEN_POSITIONS=1
# Hard cap on lots per order, whatever the UI or a strategy asks for.
MAX_LOTS=1
# Flatten open positions when you press Stop (strongly recommended).
SQUARE_OFF_ON_STOP=true
# Marketable-LIMIT buffer around LTP, because Upstox no longer accepts market orders over the API.
ORDER_PRICE_BUFFER_PCT=1.0
ORDER_FILL_TIMEOUT_S=20
PAPER_SLIPPAGE_POINTS=0.5

# ── Servers ───────────────────────────────────────────────────────────────────────────────────
# Where the OAuth callback sends you back, and the one origin the API's CORS allows.
FRONTEND_URL=http://localhost:3000
# (To change ports, set API_PORT / WEB_PORT in your shell before `npm run dev`.)


